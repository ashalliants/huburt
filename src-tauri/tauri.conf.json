{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huburt",
  "version": "0.1.2",
  "identifier": "local.huburt.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Slack, Gmail and WhatsApp in one window",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
